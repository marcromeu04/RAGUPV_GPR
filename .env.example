# Copia este archivo a .env y completa con tus valores

# Anthropic API Key - Obtén la tuya en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu-api-key-aqui

# Modelo de Claude a usar (opcional)
# Opciones: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Configuración de ChromaDB (opcional)
CHROMA_COLLECTION_NAME=advanced_rag

# Configuración de visualizaciones (opcional)
PLOT_STYLE=whitegrid
FIGURE_WIDTH=10
FIGURE_HEIGHT=6
