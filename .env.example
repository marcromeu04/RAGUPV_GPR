# Copia este archivo a .env y completa con tus valores

# Groq API Key - Obtén la tuya gratis en: https://console.groq.com/
GROQ_API_KEY=tu-api-key-aqui

# Modelo de Groq a usar (opcional)
# Opciones: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile

# Configuración de visualizaciones (opcional)
PLOT_STYLE=whitegrid
FIGURE_WIDTH=12
FIGURE_HEIGHT=6

# Configuración de embeddings (opcional)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cache de datasets (opcional)
MAX_DATASET_ROWS=1000
